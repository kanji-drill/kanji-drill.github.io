{
  "name": "kanji-drill",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run fonts && vite",
    "build": "npm run validate && npm run fonts && tsc --noEmit -p tsconfig.json && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "validate": "tsx tools/validate.ts",
    "simulate": "tsx tools/simulate.ts",
    "fonts": "tsx tools/subset-fonts.ts",
    "review": "tsx tools/build-review.ts",
    "e2e": "npm run build:pilot && playwright test",
    "lint": "biome check .",
    "build:pilot": "npm run validate && npm run fonts && tsc --noEmit -p tsconfig.json && vite build --mode pilot"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@biomejs/biome": "^2.5.15",
    "@expo-google-fonts/biz-udmincho": "^0.4.0",
    "@expo-google-fonts/biz-udpgothic": "^0.4.2",
    "@expo-google-fonts/klee-one": "^0.4.2",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "fast-check": "^4.10.2",
    "joyo-kanji": "^0.2.1",
    "jsdom": "^30.1.3",
    "subset-font": "^2.9.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
